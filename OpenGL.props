<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutDir>$(MSBuildThisFileDirectory)bin\$(Platform)\$(Configuration)\$(ProjectName)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>D:\OpenGL\GLFW\include;D:\OpenGL\GLEW\include;D:\OpenGL\GLM;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>GLFW_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>D:\OpenGL\GLFW\lib-vc2026;D:\OpenGL\GLEW\lib\Release\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>opengl32.lib;glew32.lib;glfw3dll.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>copy /Y "D:\OpenGL\GLEW\bin\Release\x64\glew32.dll" "$(OutDir)"
if errorlevel 1 exit /b 1
copy /Y "D:\OpenGL\GLFW\lib-vc2026\glfw3.dll" "$(OutDir)"
if errorlevel 1 exit /b 1</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
</Project>
