{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "OpenGL: build",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "build.bat"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "OpenGL: run",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/d", "/c", "run.bat"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "OpenGL: build",
            "problemMatcher": []
        }
    ]
}
